{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClickTrail Verify Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "target",
    "repo",
    "source",
    "browser",
    "findings",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "string",
      "format": "uri"
    },
    "repo": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "filesInspected",
        "findings",
        "eventTypes"
      ],
      "properties": {
        "filesInspected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "eventTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "browser": {
      "type": "object",
      "required": [
        "cases",
        "journey"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/browserCase"
          }
        },
        "journey": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "evidence": {
      "type": "object",
      "required": ["schemaVersion", "producer", "observations", "findings", "advisory"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "producer": { "const": "clicktrail-verify" },
        "target": {
          "type": ["object", "null"],
          "required": ["origin", "pathname", "queryKeys"],
          "additionalProperties": false,
          "properties": {
            "origin": { "type": "string", "format": "uri" },
            "pathname": { "type": "string" },
            "queryKeys": { "type": "array", "items": { "type": "string" } }
          }
        },
        "repo": { "type": ["string", "null"] },
        "contract": { "type": "object" },
        "observations": { "type": "array", "items": { "type": "object" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "advisory": { "type": "object" }
      }
    },
    "clicktrailTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "responsibility",
          "localStatus",
          "references"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "responsibility": {
            "type": "string"
          },
          "localPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "localStatus": {
            "enum": [
              "present",
              "missing",
              "not-provided"
            ]
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "clicktrailSurfaceDetected": {
      "type": "boolean"
    },
    "contract": {
      "type": "object"
    }
  },
  "$defs": {
    "browserCase": {
      "type": "object",
      "required": [
        "label",
        "consentActionClicked",
        "before",
        "after",
        "appEvents",
        "requests",
        "responses",
        "consoleErrors",
        "pageErrors"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "consentActionClicked": {
          "type": "boolean"
        },
        "before": {
          "type": "object"
        },
        "after": {
          "type": "object"
        },
        "appEvents": {
          "type": "array"
        },
        "requests": {
          "type": "array"
        },
        "responses": {
          "type": "array"
        },
        "consoleErrors": {
          "type": "array"
        },
        "pageErrors": {
          "type": "array"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "status",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "pass",
            "fail",
            "not-run",
            "warn",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "WARN",
            "UNKNOWN"
          ]
        },
        "message": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "clicktrailTargets": {
          "type": "array"
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evaluator": {
          "type": "string"
        }
      }
    }
  }
}
