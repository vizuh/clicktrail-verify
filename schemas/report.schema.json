{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClickTrail Verify Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "target",
    "repo",
    "source",
    "browser",
    "findings",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "string",
      "format": "uri"
    },
    "repo": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "filesInspected",
        "findings",
        "eventTypes"
      ],
      "properties": {
        "filesInspected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "eventTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "browser": {
      "type": "object",
      "required": [
        "cases",
        "journey"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/browserCase"
          }
        },
        "journey": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "ga4": { "$ref": "#/$defs/ga4Summary" }
          }
        },
        "preNavigation": {
          "type": ["object", "null"],
          "description": "Opt-in GA4 pre-navigation probe (contract ga4.preNavigation). Navigation targets are stubbed; forms are never submitted.",
          "required": ["consentGranted", "trigger", "navigationObserved", "offsiteNavigation", "error", "ga4"],
          "properties": {
            "consentGranted": { "type": "boolean" },
            "trigger": { "enum": ["not-attempted", "clicked", "missing", "ambiguous", "hidden", "refused-form"] },
            "navigationObserved": { "type": "boolean" },
            "offsiteNavigation": { "type": "boolean" },
            "error": { "type": ["string", "null"] },
            "ga4": { "$ref": "#/$defs/ga4Summary" }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "evidence": {
      "type": "object",
      "required": ["schemaVersion", "producer", "observations", "findings", "advisory"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "producer": { "const": "clicktrail-verify" },
        "target": {
          "type": ["object", "null"],
          "required": ["origin", "pathname", "queryKeys"],
          "additionalProperties": false,
          "properties": {
            "origin": { "type": "string", "format": "uri" },
            "pathname": { "type": "string" },
            "queryKeys": { "type": "array", "items": { "type": "string" } }
          }
        },
        "repo": { "type": ["string", "null"] },
        "contract": { "type": "object" },
        "observations": { "type": "array", "items": { "type": "object" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "advisory": { "type": "object" }
      }
    },
    "clicktrailTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "responsibility",
          "localStatus",
          "references"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "responsibility": {
            "type": "string"
          },
          "localPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "localStatus": {
            "enum": [
              "present",
              "missing",
              "not-provided"
            ]
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "clicktrailSurfaceDetected": {
      "type": "boolean"
    },
    "contract": {
      "type": "object"
    }
  },
  "$defs": {
    "browserCase": {
      "type": "object",
      "required": [
        "label",
        "consentActionClicked",
        "before",
        "after",
        "appEvents",
        "requests",
        "responses",
        "consoleErrors",
        "pageErrors"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "consentActionClicked": {
          "type": "boolean"
        },
        "before": {
          "type": "object"
        },
        "after": {
          "type": "object"
        },
        "appEvents": {
          "type": "array"
        },
        "requests": {
          "type": "array"
        },
        "responses": {
          "type": "array"
        },
        "consoleErrors": {
          "type": "array"
        },
        "pageErrors": {
          "type": "array"
        },
        "ga4": {
          "$ref": "#/$defs/ga4Summary"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "status",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "pass",
            "fail",
            "not-run",
            "warn",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "WARN",
            "UNKNOWN"
          ]
        },
        "message": {
          "type": "string"
        },
        "applicability": {
          "description": "Set when status NOT_RUN means the check's precondition is absent, not that the runner skipped it.",
          "enum": ["not-applicable"]
        },
        "owner": {
          "type": "string"
        },
        "clicktrailTargets": {
          "type": "array"
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evaluator": {
          "type": "string"
        }
      }
    },
    "formatCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numeric10": { "type": "integer", "minimum": 0 },
        "uuid": { "type": "integer", "minimum": 0 },
        "other": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 }
      }
    },
    "ga4Summary": {
      "type": ["object", "null"],
      "description": "Redacted GA4 collect-hit evidence for one isolated visit. No cid, sid, measurement ID or cookie value is stored; only counts, format classes, equality booleans and reserved parameter names.",
      "required": ["collectEventCount", "analyticsDeniedEventCount", "navigationCount", "properties", "hostSessionId", "trackedEvent"],
      "properties": {
        "collectEventCount": { "type": "integer", "minimum": 0 },
        "analyticsDeniedEventCount": { "type": "integer", "minimum": 0 },
        "navigationCount": { "type": "integer", "minimum": 0 },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "eventCount", "sid", "cookieFormat", "sidMatchesCookie", "reservedParams", "maxPageViewsPerNavigation", "duplicatePageViewNavigations"],
            "properties": {
              "label": { "type": "string", "pattern": "^property-[0-9]+$" },
              "eventCount": { "type": "integer", "minimum": 0 },
              "sid": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "distinctCount": { "type": "integer", "minimum": 0 },
                  "missingCount": { "type": "integer", "minimum": 0 },
                  "numeric10Count": { "type": "integer", "minimum": 0 },
                  "uuidCount": { "type": "integer", "minimum": 0 },
                  "otherCount": { "type": "integer", "minimum": 0 }
                }
              },
              "cookieFormat": { "enum": ["GS1", "GS2", "unparsed", "absent"] },
              "sidMatchesCookie": { "type": ["boolean", "null"] },
              "reservedParams": { "type": "array", "items": { "type": "string", "pattern": "^epn?\\.(session_id|client_id|user_id)$" } },
              "maxPageViewsPerNavigation": { "type": "integer", "minimum": 0 },
              "duplicatePageViewNavigations": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "hostSessionId": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "requestCount": { "type": "integer", "minimum": 0 },
            "valueFormats": { "$ref": "#/$defs/formatCounts" },
            "propertyResolution": { "enum": ["pinned", "single-cookie", "single-property", "ambiguous", "none"] },
            "cookieFormat": { "enum": ["GS1", "GS2", "unparsed", "absent"] },
            "matchCount": { "type": "integer", "minimum": 0 },
            "mismatchCount": { "type": "integer", "minimum": 0 }
          }
        },
        "trackedEvent": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "issuedCount": { "type": "integer", "minimum": 0 },
            "finishedCount": { "type": "integer", "minimum": 0 },
            "failedCount": { "type": "integer", "minimum": 0 },
            "unconfirmedCount": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
